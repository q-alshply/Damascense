# ─────────────────────────────────────────────────────────────
# Damascense Studio — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for metadata, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend) — inquiry notifications
RESEND_API_KEY=re_xxxxxxxx
INQUIRY_TO_EMAIL=damascense@gmail.com
INQUIRY_FROM_EMAIL=Damascense Studio <notifications@your-verified-domain.com>
